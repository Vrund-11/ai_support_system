# ── SupportPilot Environment Variables ──
# Copy to .env and fill in real values. Never commit .env.

# Common
NODE_ENV=development
LOG_LEVEL=info

# Gateway (port 4000)
GATEWAY_PORT=4000
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars!!
SERVICE_TOKEN=change-me-internal-service-token
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Ticket Service (port 4001)
TICKET_SERVICE_PORT=4001
MONGODB_URI=mongodb://localhost:27017/supportpilot
# JWT secrets (shared with gateway)
# JWT_ACCESS_SECRET — see gateway section
# JWT_REFRESH_SECRET — see gateway section
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service (port 4002)
AI_SERVICE_PORT=4002
DATABASE_URL=postgresql://supportpilot:supportpilot@localhost:5432/supportpilot
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Notification Service (port 4003)
NOTIFICATION_SERVICE_PORT=4003
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# S3 / MinIO
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=supportpilot-files
S3_FORCE_PATH_STYLE=true

# SQS (LocalStack or ElasticMQ)
SQS_ENDPOINT=http://localhost:4566

# Lambda (SAM local)
LAMBDA_ENDPOINT=http://localhost:3001

# Webhooks
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret

# Firebase (mobile push)
FCM_SERVICE_ACCOUNT_JSON=

# Sentry (optional)
SENTRY_DSN=

# SuperAdmin Platform Portal
SUPERADMIN_EMAIL=admin@supportpilot.io
SUPERADMIN_PASSWORD=SuperAdminSecret2026!
SUPERADMIN_JWT_SECRET=superadmin-platform-secret-must-be-32-chars-long!

