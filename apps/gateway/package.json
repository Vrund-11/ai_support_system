{
  "name": "@supportpilot/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supportpilot/shared-lib": "workspace:*",
    "@supportpilot/shared-types": "workspace:*",
    "@supportpilot/validators": "workspace:*",
    "dataloader": "^2.2.3",
    "express": "^5.1.0",
    "graphql": "^16.15.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@supportpilot/eslint-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
