{
  "name": "@supportpilot/ticket-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@supportpilot/shared-lib": "workspace:*",
    "@supportpilot/shared-types": "workspace:*",
    "@supportpilot/validators": "workspace:*",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@supportpilot/eslint-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.27.0",
    "fast-check": "^4.10.3",
    "rimraf": "^6.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  }
}
