  "components": {
    "schemas": {
      "AssistMessageItem": {
        "properties": {
          "sender": {
            "type": "string",
            "title": "Sender",
            "description": "Role or sender identifier: customer | agent | ai | system"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "Message body text"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At",
            "description": "Timestamp or time string"
          }
        },
        "type": "object",
        "required": ["sender", "body"],
        "title": "AssistMessageItem",
        "description": "Single chat or ticket message."
      },
      "CacheInvalidateRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "description": "Tenant ID whose cache entries should be invalidated"
          }
        },
        "type": "object",
        "required": ["tenant_id"],
        "title": "CacheInvalidateRequest"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Sender role: customer | agent | ai | system"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Message body"
          }
        },
        "type": "object",
        "required": ["role", "content"],
        "title": "ChatTurn"
      },
      "CitationItem": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Unique identifier of cited knowledge chunk"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id",
            "description": "Document ID containing chunk"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Title of source document"
          }
        },
        "type": "object",
        "required": ["chunk_id", "doc_id", "title"],
        "title": "CitationItem"
      },
      "ClassifierFeedbackRequest": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id",
            "description": "Ticket identifier"
          },
          "predicted_priority": {
            "type": "string",
            "title": "Predicted Priority"
          },
          "actual_priority": {
            "type": "string",
