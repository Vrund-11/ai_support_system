{
  "name": "supportpilot",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant AI-assisted customer-support platform",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter @supportpilot/admin dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --coverage",
    "test:postman": "vitest run tests/api/newman.test.ts",
    "test:e2e": "vitest run tests/e2e/e2e-runner.test.ts",
    "test:concurrency": "vitest run tests/integration/in-process-concurrency.test.ts",
    "test:k6:tickets": "k6 run tests/perf/tickets.js --summary-export evidence/perf/k6-load-summary.json",
    "test:k6:spike": "k6 run tests/perf/ticket-spike.js --summary-export evidence/perf/k6-spike-summary.json",
    "test:k6:chat": "k6 run tests/perf/chat.js --summary-export evidence/perf/k6-ws-summary.json",
    "test:lambda": "vitest run infra/aws/lambda/webhook-dispatcher/tests/webhook-dispatcher.test.ts",
    "test:security": "vitest run apps/ticket-service/tests/security-pass.test.ts apps/gateway/tests/security-headers.test.ts",
    "test:playwright": "playwright test --config tests/e2e/playwright.config.ts",
    "test:cypress": "cypress run --config-file tests/e2e/cypress.config.ts",
    "db:seed": "pnpm --filter ticket-service exec tsx ../../scripts/seed.ts",
    "verify": "turbo run lint typecheck test",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@size-limit/preset-app": "^11.1.6",
    "size-limit": "^11.1.6",
    "@types/newman": "^5.3.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "3.2.7",
    "cypress": "^16.3.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.1.0",
    "newman": "^6.2.3",
    "prettier": "^3.5.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.4.3",
      "cross-spawn": ">=7.0.5",
      "@graphql-tools/utils": ">=12.0.2",
      "zod": ">=4.6.6"
    }
  }
}
