{
  "name": "@supportpilot/queue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqs": {
      "types": "./dist/sqs.d.ts",
      "import": "./dist/sqs.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1173.0"
  },
  "devDependencies": {
    "@supportpilot/eslint-config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
