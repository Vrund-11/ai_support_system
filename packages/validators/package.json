{
  "name": "@supportpilot/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@supportpilot/eslint-config": "workspace:*",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  }
}
