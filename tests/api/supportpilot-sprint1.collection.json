    {
      "name": "23. Messages - Post Internal Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tenantA_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"body\":\"Verified duplicate credit charge in billing backend.\",\"isInternal\":true}"
        },
        "url": {
